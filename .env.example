# Polymarket Scalp Radar - Configuration
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# ── CREDENTIALS ──────────────────────────────────────────────
# Private key exported from Polymarket wallet (0x...)
POLYMARKET_API_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── MARKET SELECTION ────────────────────────────────────────
# Crypto asset to trade (btc, eth, sol, xrp)
MARKET_ASSET=btc
# Market window duration in minutes (5 or 15)
MARKET_WINDOW=15

# ── TRADING ──────────────────────────────────────────────────
# Maximum exposure limit in USD (open positions + pending orders)
POSITION_LIMIT=76

# USD amount per trade (can also be overridden via command line: python radar_poly.py 10)
TRADE_AMOUNT=1

# Price alert: enable (1) or disable (0) audio beep when token price crosses threshold
PRICE_ALERT_ENABLED=1
PRICE_ALERT=0.80

# Signal opportunity detection: enable (1) or disable (0) beep + trade prompt
SIGNAL_ENABLED=1
# Minimum signal strength (0-100) to trigger opportunity beep
SIGNAL_STRENGTH_BEEP=25

# Beep when BTC price moves $X or more from Price to Beat (0 = disabled)
PRICE_BEAT_ALERT=80

# Cooldown after a trade closes before the signal block can fire again, in seconds (0 = disabled)
TRADE_COOLDOWN_SEC=15

# ── INDICATOR PERIODS ────────────────────────────────────────
# RSI period (2-6 optimal for 15min; shorter = more reactive)
RSI_PERIOD=5

# MACD periods (standard 12/26/9 — confirmed adequate for 15min)
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Bollinger Bands (10/1.5 — tighter for 15min, better squeeze detection)
BB_PERIOD=10
BB_STD=1.5

# ADX period (14 = standard, recommended for regime detection)
ADX_PERIOD=14

# ── SIGNAL WEIGHTS ───────────────────────────────────────────
# Component weights for signal score (must sum to ~1.0)
# Mean reversion strategy: divergence + bollinger have higher weight
# BTC Momentum (RSI + candle score)
W_MOMENTUM=0.25
# Divergence (BTC price vs Polymarket price — key for mean reversion)
W_DIVERGENCE=0.25
# Support/Resistance levels
W_SUPPORT_RESISTANCE=0.10
# MACD histogram delta (confirmation, not primary)
W_MACD=0.10
# VWAP position + slope
W_VWAP=0.15
# Bollinger Bands position (squeeze + band touch = entry signal)
W_BOLLINGER=0.15
# Order Book Imbalance (anticipate moves based on top 5 levels)
W_ORDERBOOK_IMBALANCE=0.00

# ── VOLATILITY ───────────────────────────────────────────────
# ATR/price ratio threshold to flag high volatility (default 0.03 = 3%)
VOL_THRESHOLD=0.03
# Score multiplier when high volatility detected
VOL_AMPLIFIER=1.3

# ── REGIME ADJUSTMENT ────────────────────────────────────────
# CHOP regime: dampen signal (0.5 = reduce by 50%)
REGIME_CHOP_MULT=0.50
# TREND aligned: boost signal (1.15 = +15%)
REGIME_TREND_BOOST=1.15
# Counter-trend: reduce signal (0.7 = -30%)
REGIME_COUNTER_MULT=0.70

# ── PHASE THRESHOLDS ────────────────────────────────────────
# Min signal strength per market phase (proportional to window size)
# EARLY (>66% time left): conservative — wait for data
PHASE_EARLY_THRESHOLD=45
# MID (33-66% time left): best entry window — more permissive
PHASE_MID_THRESHOLD=25
# LATE (6-33% time left): very selective — only high conviction
PHASE_LATE_THRESHOLD=70

# ── RISK MANAGEMENT ─────────────────────────────────────────
# Maximum session loss in USD before auto-trading suspends for the session.
# Once session P&L <= -MAX_SESSION_LOSS, all auto-trades are blocked until restart.
# Set to 0 to disable (no session loss limit).
MAX_SESSION_LOSS=8

# Minimum signal strength (0-100) required for trade execution (separate from beep).
# SIGNAL_STRENGTH_BEEP controls audio; SIGNAL_STRENGTH_MIN controls execution gate.
SIGNAL_STRENGTH_MIN=30

# Hard block all auto-trades when market regime is CHOP (1=block, 0=allow with dampened score).
# CHOP was 33% of all session time in v1.2.5 data; win rate in CHOP is poor.
CHOP_BLOCK_TRADES=1

# Block trades when regime is RANGE (no directional trend confirmation)
# Log analysis: all RANGE-regime signal trades in last 2 sessions lost (0/2 win rate)
RANGE_BLOCK_TRADES=1

# Block counter-trend signals (DOWN in TREND_UP regime, UP in TREND_DOWN)
# Counter-trend trades are dampened 0.70x but still allowed — analysis shows they lose
COUNTER_TREND_BLOCK=1

# Max SL-to-entry ratio before rejecting the entry (0 = disabled)
# Prevents trading when entry is so low that SL represents an outsized % of price
# e.g. entry=$0.33, SL=$0.14 → 42% ratio → rejected at default 0.40 threshold
MIN_ENTRY_SL_RATIO=0.40

# Maximum entry price — blocks entries where TP room has collapsed near the $0.95 cap
# At entry=$0.90+, R:R drops to 0.35:1 (TP room $0.05 vs SL room $0.14)
# Safe ceiling = TP_MAX_PRICE(0.95) - TP_BASE_SPREAD(0.10) = $0.85
# Set to 0 to disable
MAX_ENTRY_PRICE=0.85

# ─────────────────────────────────────────────────────────────────────────────
# DELTA-NEUTRAL HUNTER
# ─────────────────────────────────────────────────────────────────────────────
# Scans UP + DOWN best-ask prices every DN_SCAN_INTERVAL seconds.
# When ask_UP + ask_DN < DN_THRESHOLD, both legs are bought simultaneously,
# locking in a guaranteed spread regardless of market direction.
# Payout: each share pair resolves to $1.00; profit = 1.00 - combined_ask - fees.
# Runs as a daemon thread alongside the main directional strategy.

# Enable/disable the hunter entirely (1=on, 0=off)
DN_ENABLED=1

# Combined ask ceiling to trigger arb (fires when ask_UP + ask_DN < DN_THRESHOLD)
# At 0.985 → gross spread >= 1.5%; after ~1% combined fees → net >= 0.5% per pair.
# Tighten to 0.980 for higher certainty; loosen to 0.990 for more frequency.
DN_THRESHOLD=0.985

# USD staked per LEG (total outlay = 2 x DN_STAKE per arb).
# By default, it automatically mirrors TRADE_AMOUNT if left blank.
DN_STAKE=

# Max arb trades per calendar day (resets at midnight; 0 = unlimited)
DN_MAX_DAILY=5

# Seconds between price scans (1.0 = real-time; increase to reduce API load)
DN_SCAN_INTERVAL=1.0

# Seconds before an unfilled leg order is cancelled
DN_ORDER_TIMEOUT=20

# Minimum shares per leg (Polymarket minimum order size)
DN_MIN_SHARES=5

# Per-leg fee estimate used in net-profit display only (does not affect execution)
# Polymarket 2026 taker fee is approximately 1-2% per leg depending on volume tier
DN_FEE_ESTIMATE=0.01
